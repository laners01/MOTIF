# 하이브리드(local-remote) 모드에서 서버 MQ(테일넷)에 붙을 때만 필요 (ADR-0003).
# 실제 값은 팀 비밀 저장소 참조 — 이 파일에 값을 넣지 않는다. backend/.env는 gitignore.
# 사용법: cp .env.example .env 후 값을 채우고, 실행 방법은 backend/README.md 참조.
SERVER_MQ_HOST=
SERVER_MQ_USERNAME=
SERVER_MQ_PASSWORD=

# 구글 로그인 (명세 §2.1). local·local-remote 공통.
# GOOGLE_CLIENT_ID: Google Cloud Console 의 **웹 애플리케이션** 클라이언트 ID.
#   Android 클라이언트 ID 가 아니다 — 안드로이드가 serverClientId 로 웹 ID 를 쓰기 때문에
#   발급되는 ID 토큰의 aud 가 웹 ID 다. 비밀은 아니지만(APK 에도 들어간다) 값이 틀리면
#   다른 앱의 토큰을 통과시키므로 fallback 을 두지 않았다.
# JWT_SECRET: 서비스 토큰 서명키. 미설정이면 로컬 더미가 쓰인다(application-local.yml).
#   운영은 fallback 이 없다 — core-api-secret 주입 필수.
GOOGLE_CLIENT_ID=
JWT_SECRET=
